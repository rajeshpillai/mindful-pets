#!/usr/bin/env bash
# "Ship it" / "deploy": build an optimized binary, copy it, with petctl,
# into the user's tools folder, then tag a GitHub release.
#
#   scripts/ship [--no-release] [DEST]     default DEST: ~/Desktop/tools
#
# The release is tagged vYYYY.MM.DD (vYYYY.MM.DD.N for later releases the
# same day) on the current HEAD, which must be committed and pushed to
# origin/main. Pushing the tag starts .github/workflows/release.yml, which
# cross-builds x86_64 and aarch64 archives with scripts/package and
# publishes them; this script waits for that run and prints the release URL.
set -euo pipefail

release=1
dest=""
for arg in "$@"; do
  case "$arg" in
    --no-release) release=0 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) dest="$arg" ;;
  esac
done
dest="${dest:-$HOME/Desktop/tools}"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [ "$release" = 1 ]; then
  # Check before building so a release never points at unpublished code.
  command -v gh >/dev/null || { echo "ship: gh not found (use --no-release)" >&2; exit 1; }
  if [ -n "$(git status --porcelain)" ]; then
    echo "ship: working tree has changes; commit and push first (or --no-release)" >&2
    exit 1
  fi
  git fetch -q origin main
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
    echo "ship: HEAD is not origin/main; push first (or --no-release)" >&2
    exit 1
  fi
fi

mkdir -p "$dest"
# The default build is the `auto` backend: GNOME Shell extension when it is
# running, X11 otherwise. One binary covers both.
zig build -Doptimize=ReleaseSafe
install -m 755 zig-out/bin/pet "$dest/pet"
install -m 755 scripts/petctl "$dest/petctl"
rm -f "$dest/pet-gnome" # from before the auto backend existed
rev="$(git rev-parse --short HEAD 2>/dev/null || echo untracked)"
echo "shipped $rev -> $dest/pet ($(du -h "$dest/pet" | cut -f1)) and $dest/petctl"

[ "$release" = 1 ] || exit 0

# Pick the first free tag for today, local or remote.
git fetch -q --tags origin
base="v$(date +%Y.%m.%d)"
tag="$base"
n=1
while git rev-parse -q --verify "refs/tags/$tag" >/dev/null; do
  n=$((n + 1))
  tag="$base.$n"
done

git tag -a "$tag" -m "mindful-pets $tag"
git push -q origin "$tag"
echo "pushed $tag; .github/workflows/release.yml builds and publishes it"

# Wait for the tag's workflow run so a failed CI build is seen right away.
run=""
for _ in $(seq 30); do
  run="$(gh run list --workflow release.yml --branch "$tag" --limit 1 --json databaseId -q '.[0].databaseId' 2>/dev/null || true)"
  [ -n "$run" ] && break
  sleep 2
done
if [ -z "$run" ]; then
  echo "ship: no release workflow run found for $tag; check the Actions tab" >&2
  exit 1
fi
gh run watch "$run" --exit-status >/dev/null || {
  echo "ship: release build failed: $(gh run view "$run" --json url -q .url)" >&2
  exit 1
}
echo "released $tag: $(gh release view "$tag" --json url -q .url)"
