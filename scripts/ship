#!/usr/bin/env bash
# "Ship it" / "deploy": build an optimized binary, copy it, with petctl,
# into the user's tools folder, and publish a GitHub release with the same
# binaries.
#
#   scripts/ship [--no-release] [DEST]     default DEST: ~/Desktop/tools
#
# The release is tagged vYYYY.MM.DD (vYYYY.MM.DD.N for later releases the
# same day) on the current HEAD, which must be committed and pushed to
# origin/main. Its asset is mindful-pets-TAG-linux-ARCH.tar.gz holding pet,
# scripts/petctl, scripts/install-extension, the GNOME Shell extension and
# README.md, plus a .sha256 next to it.
set -euo pipefail

release=1
dest=""
for arg in "$@"; do
  case "$arg" in
    --no-release) release=0 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) dest="$arg" ;;
  esac
done
dest="${dest:-$HOME/Desktop/tools}"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [ "$release" = 1 ]; then
  # Check before building so a release never points at unpublished code.
  command -v gh >/dev/null || { echo "ship: gh not found (use --no-release)" >&2; exit 1; }
  if [ -n "$(git status --porcelain)" ]; then
    echo "ship: working tree has changes; commit and push first (or --no-release)" >&2
    exit 1
  fi
  git fetch -q origin main
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
    echo "ship: HEAD is not origin/main; push first (or --no-release)" >&2
    exit 1
  fi
fi

mkdir -p "$dest"
# The default build is the `auto` backend: GNOME Shell extension when it is
# running, X11 otherwise. One binary covers both.
zig build -Doptimize=ReleaseSafe
install -m 755 zig-out/bin/pet "$dest/pet"
install -m 755 scripts/petctl "$dest/petctl"
rm -f "$dest/pet-gnome" # from before the auto backend existed
rev="$(git rev-parse --short HEAD 2>/dev/null || echo untracked)"
echo "shipped $rev -> $dest/pet ($(du -h "$dest/pet" | cut -f1)) and $dest/petctl"

[ "$release" = 1 ] || exit 0

# Pick the first free tag for today, local or remote.
git fetch -q --tags origin
base="v$(date +%Y.%m.%d)"
tag="$base"
n=1
while git rev-parse -q --verify "refs/tags/$tag" >/dev/null; do
  n=$((n + 1))
  tag="$base.$n"
done

arch="$(uname -m)"
name="mindful-pets-$tag-linux-$arch"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
pkg="$work/$name"
mkdir -p "$pkg/scripts"
install -m 755 zig-out/bin/pet "$pkg/pet"
install -m 755 scripts/petctl scripts/install-extension "$pkg/scripts/"
cp -r gnome-extension "$pkg/gnome-extension"
cp README.md "$pkg/"
tar -C "$work" -czf "$work/$name.tar.gz" "$name"
(cd "$work" && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256")

prev="$(git describe --tags --abbrev=0 HEAD 2>/dev/null || true)"
notes="$work/notes.md"
{
  echo "Built from $rev with \`zig build -Doptimize=ReleaseSafe\` (auto backend: GNOME Shell extension when running, X11 otherwise)."
  echo
  echo "Unpack, run \`scripts/install-extension\` for the GNOME backend, then \`./pet\`. Needs libX11/libXext/libXfixes/libXrandr and python3 for petctl."
  echo
  echo "## Changes"
  if [ -n "$prev" ]; then
    git log --no-merges --format='- %s' "$prev..HEAD"
  else
    git log --no-merges --format='- %s' -n 20
  fi
} > "$notes"

git tag -a "$tag" -m "mindful-pets $tag"
git push -q origin "$tag"
gh release create "$tag" --title "mindful-pets $tag" --notes-file "$notes" \
  "$work/$name.tar.gz" "$work/$name.tar.gz.sha256"
echo "released $tag: $(gh release view "$tag" --json url -q .url)"
